# WhatsApp Gateway Service Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (supports 'sqlite' or 'mysql')
DB_CLIENT=sqlite
# For SQLite:
DB_SQLITE_FILE=./data/gateway.sqlite
# For MySQL:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_gateway

# Meta WhatsApp Cloud API Credentials (Default / Gateway Number)
META_WA_PHONE_NUMBER_ID=your_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_token
META_WA_WABA_ID=your_waba_id
META_WA_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=whatsapp_gateway_secret_verify_token

# Default Pricing
DEFAULT_PER_MESSAGE_RATE=0.80
DEFAULT_CURRENCY=INR
